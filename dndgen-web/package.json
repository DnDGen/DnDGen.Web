{
  "name": "dndgen-web",
  "version": "2.5.4",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration development",
    "build:ci": "ng build --configuration production",
    "test": "npm run test:unit && npm run test:integration",
    "test:rollgen": "ng test --no-watch --include='src/app/roll/**/*.spec.ts'",
    "test:treasuregen": "ng test --no-watch --include='src/app/treasure/**/*.spec.ts'",
    "test:charactergen": "ng test --no-watch --include='src/app/character/**/*.spec.ts'",
    "test:encountergen": "ng test --no-watch --include='src/app/encounter/**/*.spec.ts'",
    "test:dungeongen": "ng test --no-watch --include='src/app/dungeon/**/*.spec.ts'",
    "test:unit": "ng test --no-watch --include='src/**/*.unit.spec.ts'",
    "test:integration": "ng test --no-watch --include='src/**/*.integration.spec.ts'",
    "test:unit:ci": "ng test --no-watch --runner-config vitest.config.ci.ts --include='src/**/*.unit.spec.ts'",
    "test:integration:ci": "ng test --no-watch --runner-config vitest.config.ci.integration.ts --include='src/**/*.integration.spec.ts'",
    "test:integration:ci:rollgen": "ng test --no-watch --runner-config vitest.config.ci.integration.ts --include='src/app/roll/**/*.integration.spec.ts'",
    "test:integration:ci:treasuregen": "ng test --no-watch --runner-config vitest.config.ci.integration.ts --include='src/app/treasure/**/*.integration.spec.ts'",
    "test:integration:ci:charactergen": "ng test --no-watch --runner-config vitest.config.ci.integration.ts --include='src/app/character/**/*.integration.spec.ts'",
    "test:integration:ci:encountergen": "ng test --no-watch --runner-config vitest.config.ci.integration.ts --include='src/app/encounter/**/*.integration.spec.ts'",
    "test:integration:ci:dungeongen": "ng test --no-watch --runner-config vitest.config.ci.integration.ts --include='src/app/dungeon/**/*.integration.spec.ts'"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.9",
    "@angular/common": "^21.2.9",
    "@angular/compiler": "^21.2.9",
    "@angular/core": "^21.2.9",
    "@angular/forms": "^21.2.9",
    "@angular/platform-browser": "^21.2.9",
    "@angular/router": "^21.2.9",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "@popperjs/core": "^2.11.8",
    "@types/file-saver": "^2.0.7",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.0.0",
    "file-saver": "^2.0.5",
    "rxjs": "^7.8.2",
    "sweetalert2": "^11.26.20"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.3.1",
    "@angular-devkit/build-angular": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.9",
    "@angular/localize": "^21.2.9",
    "@vitest/ui": "^4.0.18",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
